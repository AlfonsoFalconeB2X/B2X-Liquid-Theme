{%- comment -%}
  Righe del carrello, condivise da carrello a cassetto e pagina carrello.
  Parametro: context ('drawer' | 'page'), rende unici gli id.
  Senza JS (solo pagina carrello) quantità e rimozione funzionano con il form `updates[]` e i link `url_to_remove`.
{%- endcomment -%}
<ul class="cart-lines" role="list">
  {%- for item in cart.items -%}
    {%- liquid
      assign line_id = 'CartLine-' | append: context | append: '-' | append: forloop.index
      assign item_title = item.product.title | escape
      assign increment = item.variant.quantity_rule.increment | default: 1
    -%}
    <li class="cart-line" id="{{ line_id }}" data-line="{{ forloop.index }}">
      <a class="cart-line__media" href="{{ item.url }}" tabindex="-1" aria-hidden="true">
        <span class="media" style="--ratio: 0.8;">
          {%- if item.image -%}
            {{ item.image | image_url: width: 240 | image_tag: widths: '120, 180, 240', sizes: '6rem', loading: 'lazy', alt: '' }}
          {%- else -%}
            {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
          {%- endif -%}
        </span>
      </a>

      <div class="cart-line__info">
        <a class="cart-line__title" href="{{ item.url }}">{{ item.product.title | escape }}</a>

        {%- unless item.product.has_only_default_variant -%}
          <ul class="cart-line__meta" role="list">
            {%- for option in item.options_with_values -%}
              <li>{{ option.name | escape }}: {{ option.value | escape }}</li>
            {%- endfor -%}
          </ul>
        {%- endunless -%}

        {%- if item.properties.size > 0 -%}
          <ul class="cart-line__meta" role="list">
            {%- for property in item.properties -%}
              {%- assign first_char = property.first | slice: 0 -%}
              {%- if property.last != blank and first_char != '_' -%}
                <li>
                  {{ property.first | escape }}:
                  {% if property.last contains '/uploads/' -%}
                    <a href="{{ property.last }}" target="_blank" rel="noopener">{{ property.last | split: '/' | last }}</a>
                  {%- else -%}
                    {{ property.last | escape }}
                  {%- endif %}
                </li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        {%- endif -%}

        {%- if item.selling_plan_allocation -%}
          <p class="cart-line__meta">{{ item.selling_plan_allocation.selling_plan.name | escape }}</p>
        {%- endif -%}

        {%- for discount in item.line_level_discount_allocations -%}
          <p class="cart-line__discount">{{ discount.discount_application.title | escape }} (−{{ discount.amount | money }})</p>
        {%- endfor -%}

        {%- if item.unit_price_measurement -%}
          <p class="cart-line__meta">
            {{- item.unit_price | money }}/
            {%- if item.unit_price_measurement.reference_value != 1 -%}
              {{- item.unit_price_measurement.reference_value -}}
            {%- endif -%}
            {{- item.unit_price_measurement.reference_unit -}}
          </p>
        {%- endif -%}

        <div class="cart-line__actions">
          <quantity-input class="quantity quantity--small">
            <button type="button" class="quantity__button" data-quantity="minus" aria-label="{{ 'cart.decrease' | t: product: item_title }}">
              {%- render 'icon', name: 'minus', class: 'icon--small' -%}
            </button>
            <input
              class="quantity__input"
              type="number"
              name="updates[]"
              id="Quantity-{{ context }}-{{ forloop.index }}"
              value="{{ item.quantity }}"
              min="0"
              step="{{ increment }}"
              {% if item.variant.quantity_rule.max != null %}max="{{ item.variant.quantity_rule.max }}"{% endif %}
              data-line="{{ forloop.index }}"
              aria-label="{{ 'cart.quantity_for' | t: product: item_title }}"
            >
            <button type="button" class="quantity__button" data-quantity="plus" aria-label="{{ 'cart.increase' | t: product: item_title }}">
              {%- render 'icon', name: 'plus', class: 'icon--small' -%}
            </button>
          </quantity-input>

          <a
            class="icon-button cart-line__remove"
            id="Remove-{{ context }}-{{ forloop.index }}"
            href="{{ item.url_to_remove }}"
            data-line-remove="{{ forloop.index }}"
            aria-label="{{ 'cart.remove' | t: product: item_title }}"
          >
            {%- render 'icon', name: 'trash', class: 'icon--small' -%}
          </a>
        </div>

        <p class="form-message form-message--error" role="alert" data-line-error hidden></p>
      </div>

      <div class="cart-line__price">
        {%- if item.original_line_price != item.final_line_price -%}
          <span class="visually-hidden">{{ 'products.product.price.regular_price' | t }}</span>
          <s class="price__compare">{{ item.original_line_price | money }}</s>
          <span class="visually-hidden">{{ 'products.product.price.sale_price' | t }}</span>
        {%- endif -%}
        <span>{{ item.final_line_price | money }}</span>
      </div>
    </li>
  {%- endfor -%}
</ul>
