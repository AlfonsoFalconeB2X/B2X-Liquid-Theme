{%- comment -%}
  Icone SVG a tratto (24×24). Uso: {% render 'icon', name: 'search', class: 'icon--small' %}
  Le icone sono decorative: il nome accessibile va sul controllo che le contiene.
{%- endcomment -%}
{%- capture paths -%}
  {%- case name -%}
    {%- when 'search' -%}<circle cx="11" cy="11" r="6.5"/><path d="m20 20-4.4-4.4"/>
    {%- when 'bag' -%}<path d="M5.5 8.5h13l-.9 11a1.5 1.5 0 0 1-1.5 1.4H7.9a1.5 1.5 0 0 1-1.5-1.4l-.9-11Z"/><path d="M9 8.5V7a3 3 0 0 1 6 0v1.5"/>
    {%- when 'user' -%}<circle cx="12" cy="8" r="3.75"/><path d="M4.5 20c1.2-3.6 4-5.5 7.5-5.5s6.3 1.9 7.5 5.5"/>
    {%- when 'menu' -%}<path d="M4 7h16M4 12h16M4 17h10"/>
    {%- when 'close' -%}<path d="m6 6 12 12M18 6 6 18"/>
    {%- when 'chevron-down' -%}<path d="m6 9 6 6 6-6"/>
    {%- when 'chevron-left' -%}<path d="m15 6-6 6 6 6"/>
    {%- when 'chevron-right' -%}<path d="m9 6 6 6-6 6"/>
    {%- when 'arrow-right' -%}<path d="M5 12h14M13 6l6 6-6 6"/>
    {%- when 'arrow-left' -%}<path d="M19 12H5M11 6l-6 6 6 6"/>
    {%- when 'plus' -%}<path d="M12 5v14M5 12h14"/>
    {%- when 'minus' -%}<path d="M5 12h14"/>
    {%- when 'check' -%}<path d="m5 12.5 4.5 4.5L19 7.5"/>
    {%- when 'trash' -%}<path d="M4.5 7h15M9.5 7V4.5h5V7M6.5 7l.8 12.1a1.5 1.5 0 0 0 1.5 1.4h6.4a1.5 1.5 0 0 0 1.5-1.4L17.5 7"/>
    {%- when 'filter' -%}<path d="M4 7h9M17 7h3M4 17h3M11 17h9"/><circle cx="15" cy="7" r="2"/><circle cx="9" cy="17" r="2"/>
    {%- when 'truck' -%}<path d="M3 6.5h11v9.5H3zM14 9.5h3.6L21 13v3h-7"/><circle cx="7" cy="17.5" r="1.75"/><circle cx="17" cy="17.5" r="1.75"/>
    {%- when 'return' -%}<path d="M9 14 4 9l5-5"/><path d="M4 9h10.5a5.5 5.5 0 0 1 0 11H11"/>
    {%- when 'lock' -%}<rect x="5.5" y="10.5" width="13" height="10" rx="2"/><path d="M8.5 10.5V8a3.5 3.5 0 0 1 7 0v2.5"/>
    {%- when 'chat' -%}<path d="M5 5.5h14a1 1 0 0 1 1 1v8.5a1 1 0 0 1-1 1H10l-5 4v-4a1 1 0 0 1-1-1V6.5a1 1 0 0 1 1-1Z"/>
    {%- when 'leaf' -%}<path d="M5 19c0-8.5 5-13.5 14-14 0 9-5 14-13.5 14"/><path d="M5 19 13 11"/>
    {%- when 'gift' -%}<path d="M4 9h16v4H4zM5.5 13v7h13v-7M12 9v11"/><path d="M12 9S10.6 4.6 8.3 5.1C6.2 5.6 7 9 12 9Zm0 0s1.4-4.4 3.7-3.9C17.8 5.6 17 9 12 9Z"/>
    {%- when 'star' -%}<path d="m12 3.6 2.6 5.3 5.8.8-4.2 4.1 1 5.8-5.2-2.7-5.2 2.7 1-5.8-4.2-4.1 5.8-.8L12 3.6Z"/>
    {%- when 'heart' -%}<path d="M12 20s-7.5-4.6-7.5-10.2A4.3 4.3 0 0 1 12 7a4.3 4.3 0 0 1 7.5 2.8C19.5 15.4 12 20 12 20Z"/>
    {%- when 'mail' -%}<rect x="3.5" y="5.5" width="17" height="13" rx="2"/><path d="m4 7 8 6 8-6"/>
    {%- when 'phone' -%}<path d="M6.5 3.5h3l1.5 4-2 1.3a10 10 0 0 0 6.2 6.2l1.3-2 4 1.5v3a2 2 0 0 1-2 2A16 16 0 0 1 4.5 5.5a2 2 0 0 1 2-2Z"/>
    {%- when 'pin' -%}<path d="M12 21s-6.5-5.6-6.5-11a6.5 6.5 0 0 1 13 0c0 5.4-6.5 11-6.5 11Z"/><circle cx="12" cy="10" r="2.25"/>
    {%- when 'play' -%}<path d="M8 5.5v13l10.5-6.5L8 5.5Z"/>
    {%- when 'share' -%}<path d="M12 4v11M7.5 8.5 12 4l4.5 4.5M5 13.5V19a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-5.5"/>
    {%- when 'info' -%}<circle cx="12" cy="12" r="8.5"/><path d="M12 11v5M12 8h.01"/>
  {%- endcase -%}
{%- endcapture -%}
<svg class="icon icon-{{ name }}{% if class %} {{ class }}{% endif %}" viewBox="0 0 24 24" aria-hidden="true" focusable="false">{{ paths }}</svg>
