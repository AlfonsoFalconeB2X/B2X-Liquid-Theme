{% render 'vite-tag', entry: 'rich-text.css' %}
{%- assign s = section.settings -%}
<div {% render 'section-attributes', section: section %}>
  <div class="section__inner page-width">
    <div class="rich-text{% if s.align == 'center' %} rich-text--center{% endif %} reveal">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'kicker' -%}
            <p class="kicker" {{ block.shopify_attributes }}>{{ block.settings.text | escape }}</p>
          {%- when 'heading' -%}
            <h2 class="{{ block.settings.size }}" {{ block.shopify_attributes }}>{{ block.settings.heading | escape }}</h2>
          {%- when 'text' -%}
            <div class="rte text-lead text-muted" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>
          {%- when 'buttons' -%}
            {%- liquid
              assign has_1 = false
              assign has_2 = false
              if block.settings.label_1 != blank and block.settings.link_1 != blank
                assign has_1 = true
              endif
              if block.settings.label_2 != blank and block.settings.link_2 != blank
                assign has_2 = true
              endif
            -%}
            {%- if has_1 or has_2 -%}
              <div class="button-group" {{ block.shopify_attributes }}>
                {%- if has_1 -%}
                  <a class="button" href="{{ block.settings.link_1 }}">{{ block.settings.label_1 | escape }}</a>
                {%- endif -%}
                {%- if has_2 -%}
                  <a class="button button--secondary" href="{{ block.settings.link_2 }}">{{ block.settings.label_2 | escape }}</a>
                {%- endif -%}
              </div>
            {%- endif -%}
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Testo",
  "class": "section-rich-text",
  "max_blocks": 6,
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    {
      "type": "select",
      "id": "align",
      "label": "Allineamento",
      "options": [
        { "value": "left", "label": "Sinistra" },
        { "value": "center", "label": "Centro" }
      ],
      "default": "center"
    },
    { "type": "header", "content": "Aspetto" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Schema colori", "default": "scheme-1" },
    {
      "type": "select",
      "id": "section_style",
      "label": "Stile",
      "options": [
        { "value": "full", "label": "A tutta larghezza" },
        { "value": "boxed", "label": "Riquadro" }
      ],
      "default": "full"
    },
    { "type": "range", "id": "padding_top", "label": "Spazio sopra", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 64 },
    { "type": "range", "id": "padding_bottom", "label": "Spazio sotto", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 64 }
  ],
  "blocks": [
    {
      "type": "kicker",
      "name": "Etichetta",
      "limit": 1,
      "settings": [{ "type": "text", "id": "text", "label": "Testo", "default": "Chi siamo" }]
    },
    {
      "type": "heading",
      "name": "Titolo",
      "settings": [
        { "type": "text", "id": "heading", "label": "Titolo", "default": "Racconta il tuo marchio" },
        {
          "type": "select",
          "id": "size",
          "label": "Dimensione",
          "options": [
            { "value": "h3", "label": "Piccola" },
            { "value": "h2", "label": "Media" },
            { "value": "h1", "label": "Grande" }
          ],
          "default": "h2"
        }
      ]
    },
    {
      "type": "text",
      "name": "Testo",
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "label": "Testo",
          "default": "<p>Condividi la storia del negozio, i valori o un messaggio importante per i clienti.</p>"
        }
      ]
    },
    {
      "type": "buttons",
      "name": "Pulsanti",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "label_1", "label": "Etichetta pulsante principale", "default": "Scopri di più" },
        { "type": "url", "id": "link_1", "label": "Link pulsante principale" },
        { "type": "text", "id": "label_2", "label": "Etichetta pulsante secondario" },
        { "type": "url", "id": "link_2", "label": "Link pulsante secondario" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Testo",
      "blocks": [{ "type": "kicker" }, { "type": "heading" }, { "type": "text" }, { "type": "buttons" }]
    }
  ]
}
{% endschema %}
