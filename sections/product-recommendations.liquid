{%- liquid
  assign s = section.settings
  assign columns = s.columns_desktop
  assign columns_tablet = columns | at_most: 3
  assign column_width = settings.page_width | divided_by: columns
  assign sizes = '(min-width: 990px) ' | append: column_width | append: 'px, (min-width: 750px) 33vw, 50vw'

  assign carousel = false
  if s.layout == 'carousel'
    assign carousel = true
  endif
-%}

{%- comment -%} Fuori da <product-recommendations>: il contenuto arriva dopo, con la Section Rendering API {%- endcomment -%}
{%- if carousel -%}
  {% render 'vite-tag', entry: 'carousel.css' %}
  {% render 'vite-tag', entry: 'carousel.js' %}
{%- endif -%}

<div {% render 'section-attributes', section: section %}>
  <div class="section__inner page-width">
    <product-recommendations
      data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ s.products_to_show }}&intent={{ s.intent }}"
    >
      {%- if recommendations.performed? and recommendations.products_count > 0 -%}
        {%- capture heading -%}
          {%- render 'section-heading', kicker: s.kicker, heading: s.heading, align: s.heading_align -%}
        {%- endcapture -%}
        {%- capture items -%}
          {%- for recommendation in recommendations.products -%}
            <li{% if carousel %} class="carousel__slide"{% endif %}>
              {%- render 'product-card', product: recommendation, section_id: section.id, sizes: sizes -%}
            </li>
          {%- endfor -%}
        {%- endcapture -%}

        {%- if carousel -%}
          {%- render 'carousel-track',
            id: section.id,
            items: items,
            heading: heading,
            align: s.heading_align,
            label: s.heading,
            per_view: columns,
            per_view_mobile: '2.2',
            list_attributes: 'data-recommendations-list'
          -%}
        {%- else -%}
          {{- heading -}}
          <ul
            class="grid grid--slider"
            role="list"
            data-recommendations-list
            style="--cols-mobile: 2; --cols-tablet: {{ columns_tablet }}; --cols-desktop: {{ columns }}; --slide-width: 44%;"
          >
            {{- items -}}
          </ul>
        {%- endif -%}
      {%- endif -%}
    </product-recommendations>
  </div>
</div>

{% schema %}
{
  "name": "Prodotti consigliati",
  "class": "section-product-recommendations",
  "enabled_on": { "templates": ["product"] },
  "settings": [
    { "type": "text", "id": "kicker", "label": "Etichetta" },
    { "type": "text", "id": "heading", "label": "Titolo", "default": "Potrebbe piacerti anche" },
    {
      "type": "select",
      "id": "heading_align",
      "label": "Allineamento intestazione",
      "options": [
        { "value": "left", "label": "Sinistra" },
        { "value": "center", "label": "Centro" }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "intent",
      "label": "Tipo di consigli",
      "options": [
        { "value": "related", "label": "Prodotti correlati" },
        { "value": "complementary", "label": "Prodotti complementari" }
      ],
      "default": "related",
      "info": "I complementari si impostano con l'app Search & Discovery."
    },
    { "type": "range", "id": "products_to_show", "label": "Prodotti da mostrare", "min": 2, "max": 10, "step": 1, "default": 4 },
    { "type": "header", "content": "Disposizione" },
    {
      "type": "select",
      "id": "layout",
      "label": "Mostra come",
      "options": [
        { "value": "grid", "label": "Griglia" },
        { "value": "carousel", "label": "Carosello" }
      ],
      "default": "grid"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Colonne su desktop",
      "info": "Con il carosello: prodotti visibili insieme.",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4
    },
    { "type": "header", "content": "Aspetto" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Schema colori", "default": "scheme-1" },
    {
      "type": "select",
      "id": "section_style",
      "label": "Stile",
      "options": [
        { "value": "full", "label": "A tutta larghezza" },
        { "value": "boxed", "label": "Riquadro" }
      ],
      "default": "full"
    },
    { "type": "range", "id": "padding_top", "label": "Spazio sopra", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "padding_bottom", "label": "Spazio sotto", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 64 }
  ],
  "presets": [{ "name": "Prodotti consigliati" }]
}
{% endschema %}
