{%- liquid
  assign s = section.settings
  assign columns = s.columns_desktop
  assign columns_tablet = columns | at_most: 3
  assign column_width = settings.page_width | divided_by: columns
  assign sizes = '(min-width: 990px) ' | append: column_width | append: 'px, (min-width: 750px) 33vw, 50vw'
  case s.sort
    when 'alphabetical'
      assign sorted = collections | sort: 'title'
    when 'products_high'
      assign sorted = collections | sort: 'all_products_count' | reverse
    else
      assign sorted = collections
  endcase
-%}

<div {% render 'section-attributes', section: section %}>
  <div class="section__inner page-width">
    <div class="page-header">
      <h1>
        {%- if s.title != blank -%}{{ s.title | escape }}{%- else -%}{{ 'collections.all_collections' | t }}{%- endif -%}
      </h1>
    </div>

    {%- paginate sorted by 24 -%}
      <ul class="grid" role="list" style="--cols-mobile: 2; --cols-tablet: {{ columns_tablet }}; --cols-desktop: {{ columns }};">
        {%- for collection in sorted -%}
          <li>{% render 'collection-card', collection: collection, sizes: sizes, show_count: s.show_count %}</li>
        {%- endfor -%}
      </ul>
      {% render 'pagination', paginate: paginate %}
    {%- endpaginate -%}
  </div>
</div>

{% schema %}
{
  "name": "Elenco collezioni",
  "class": "section-main-list-collections",
  "enabled_on": { "templates": ["list-collections"] },
  "settings": [
    { "type": "text", "id": "title", "label": "Titolo", "info": "Se vuoto: \"Collezioni\" nella lingua del negozio." },
    {
      "type": "select",
      "id": "sort",
      "label": "Ordina le collezioni",
      "options": [
        { "value": "default", "label": "Come nell'admin" },
        { "value": "alphabetical", "label": "Alfabetico" },
        { "value": "products_high", "label": "Numero di prodotti" }
      ],
      "default": "default"
    },
    { "type": "range", "id": "columns_desktop", "label": "Colonne su desktop", "min": 2, "max": 5, "step": 1, "default": 4 },
    { "type": "checkbox", "id": "show_count", "label": "Mostra numero di prodotti", "default": true },
    { "type": "header", "content": "Aspetto" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Schema colori", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "label": "Spazio sopra", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "padding_bottom", "label": "Spazio sotto", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 80 }
  ]
}
{% endschema %}
