{%- assign s = section.settings -%}
<div {% render 'section-attributes', section: section, class: 'password' %}>
  <div class="section__inner page-width page-width--narrow">
    <div class="empty-state password__content">
      <p class="header__logo-text">{{ shop.name }}</p>
      {%- if s.heading != blank -%}
        <h1>{{ s.heading | escape }}</h1>
      {%- endif -%}
      {%- if shop.password_message != blank -%}
        <p class="text-muted text-lead">{{ shop.password_message }}</p>
      {%- endif -%}

      {%- if s.show_newsletter -%}
        <div class="password__newsletter">
          {% render 'newsletter-form', form_id: 'PasswordNewsletter' %}
        </div>
      {%- endif -%}

      {%- form 'storefront_password', class: 'password__login-form' -%}
      <details class="password__login"{% if form.errors %} open{% endif %}>
        <summary class="link">{{ 'password.owner_login' | t }}</summary>
        <div class="password__form">
          {%- if form.errors -%}
            <p class="form-message form-message--error" role="alert">{{ 'password.wrong_password' | t }}</p>
          {%- endif -%}
          <label class="visually-hidden" for="StorefrontPassword">{{ 'password.label' | t }}</label>
          <div class="inline-form">
            <input
              class="input"
              id="StorefrontPassword"
              type="password"
              name="password"
              autocomplete="current-password"
              placeholder="{{ 'password.label' | t }}"
              required
              {% if form.errors %}aria-invalid="true" autofocus{% endif %}
            >
            <button type="submit" class="button">{{ 'password.enter' | t }}</button>
          </div>
        </div>
      </details>
      {%- endform -%}
      <p class="text-small text-muted">{{ 'password.powered_by_html' | t: shopify: powered_by_link }}</p>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Password",
  "class": "section-main-password",
  "enabled_on": { "templates": ["password"] },
  "settings": [
    { "type": "text", "id": "heading", "label": "Titolo", "default": "Apriamo presto" },
    { "type": "checkbox", "id": "show_newsletter", "label": "Mostra iscrizione newsletter", "default": true },
    { "type": "color_scheme", "id": "color_scheme", "label": "Schema colori", "default": "scheme-2" },
    {
      "type": "select",
      "id": "section_style",
      "label": "Stile",
      "options": [
        { "value": "full", "label": "A tutta larghezza" },
        { "value": "boxed", "label": "Riquadro" }
      ],
      "default": "full"
    },
    { "type": "range", "id": "padding_top", "label": "Spazio sopra", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 96 },
    { "type": "range", "id": "padding_bottom", "label": "Spazio sotto", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 96 }
  ]
}
{% endschema %}
