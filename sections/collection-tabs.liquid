<script src="{{ 'collection-tabs.js' | asset_url }}" type="module"></script>
{%- liquid
  assign s = section.settings
  assign columns = s.columns_desktop
  assign columns_tablet = columns | at_most: 3
  assign column_width = settings.page_width | divided_by: columns
  assign sizes = '(min-width: 990px) ' | append: column_width | append: 'px, (min-width: 750px) 33vw, 50vw'
-%}

<div {% render 'section-attributes', section: section %}>
  <div class="section__inner page-width">
    <collection-tabs class="tabs">
      <div class="tabs__head">
        {%- render 'section-heading', kicker: s.kicker, heading: s.heading, text: s.text -%}
        {%- if section.blocks.size > 1 -%}
          <div class="tabs__list" role="tablist" aria-label="{{ s.heading | default: shop.name | escape }}">
            {%- for block in section.blocks -%}
              {%- assign tab_title = block.settings.title | default: block.settings.collection.title -%}
              {%- if tab_title == blank -%}{%- assign tab_title = 'collections.placeholder_title' | t -%}{%- endif -%}
              <button
                type="button"
                class="tabs__tab"
                role="tab"
                id="Tab-{{ block.id }}"
                aria-controls="TabPanel-{{ block.id }}"
                aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
                tabindex="{% if forloop.first %}0{% else %}-1{% endif %}"
                {{ block.shopify_attributes }}
              >
                {{- tab_title | escape -}}
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      {%- for block in section.blocks -%}
        {%- assign collection = block.settings.collection -%}
        <div
          class="tabs__panel"
          id="TabPanel-{{ block.id }}"
          {% if section.blocks.size > 1 %}role="tabpanel" aria-labelledby="Tab-{{ block.id }}" tabindex="0"{% endif %}
          {% if forloop.first %}data-active{% endif %}
        >
          <ul class="grid grid--slider" role="list" style="--cols-mobile: 2; --cols-tablet: {{ columns_tablet }}; --cols-desktop: {{ columns }}; --slide-width: 44%;">
            {%- if collection != blank and collection.products_count > 0 -%}
              {%- for product in collection.products limit: s.products_to_show -%}
                <li class="reveal">{% render 'product-card', product: product, section_id: section.id, sizes: sizes %}</li>
              {%- endfor -%}
            {%- else -%}
              {%- for i in (1..4) -%}
                <li>{% render 'product-card', product: blank, placeholder_index: forloop.index0, section_id: section.id %}</li>
              {%- endfor -%}
            {%- endif -%}
          </ul>
          {%- if s.show_view_all and collection != blank -%}
            <div class="section-footer-link">
              <a class="button button--secondary" href="{{ collection.url }}">
                {{- 'sections.collection_tabs.view_all' | t: title: collection.title -}}
              </a>
            </div>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </collection-tabs>
  </div>
</div>

{% schema %}
{
  "name": "Tab di collezioni",
  "class": "section-collection-tabs",
  "max_blocks": 6,
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "text", "id": "kicker", "label": "Etichetta" },
    { "type": "text", "id": "heading", "label": "Titolo", "default": "Scegli per categoria" },
    { "type": "richtext", "id": "text", "label": "Testo" },
    { "type": "range", "id": "products_to_show", "label": "Prodotti per tab", "min": 2, "max": 12, "step": 1, "default": 4 },
    { "type": "range", "id": "columns_desktop", "label": "Colonne su desktop", "min": 2, "max": 5, "step": 1, "default": 4 },
    { "type": "checkbox", "id": "show_view_all", "label": "Pulsante \"Vedi tutti\" sotto ogni tab", "default": true },
    { "type": "header", "content": "Aspetto" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Schema colori", "default": "scheme-1" },
    {
      "type": "select",
      "id": "section_style",
      "label": "Stile",
      "options": [
        { "value": "full", "label": "A tutta larghezza" },
        { "value": "boxed", "label": "Riquadro" }
      ],
      "default": "full"
    },
    { "type": "range", "id": "padding_top", "label": "Spazio sopra", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 64 },
    { "type": "range", "id": "padding_bottom", "label": "Spazio sotto", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 64 }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collezione",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collezione" },
        { "type": "text", "id": "title", "label": "Titolo della tab", "info": "Se vuoto usa il nome della collezione." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Tab di collezioni",
      "blocks": [{ "type": "collection" }, { "type": "collection" }, { "type": "collection" }]
    }
  ]
}
{% endschema %}
