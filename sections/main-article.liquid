{%- assign s = section.settings -%}
<div {% render 'section-attributes', section: section %}>
  <article class="section__inner page-width page-width--reading">
    <header class="article__header">
      {%- if s.show_blog_link -%}
        <a class="chip-link" href="{{ blog.url }}">
          {%- render 'icon', name: 'arrow-left', class: 'icon--small' -%}
          {{ blog.title | escape }}
        </a>
      {%- endif -%}
      <h1>{{ article.title | escape }}</h1>
      <p class="article__meta">
        {%- if s.show_date -%}{{ article.published_at | time_tag: format: 'date' }}{%- endif -%}
        {%- if s.show_date and s.show_author %} · {% endif -%}
        {%- if s.show_author -%}{{ 'blogs.article.by_author' | t: author: article.author }}{%- endif -%}
      </p>
    </header>

    {%- if article.image and s.show_image -%}
      <div class="media article__image" style="--ratio: {{ article.image.aspect_ratio | at_least: 1.25 }};">
        {{
          article.image
          | image_url: width: 1600
          | image_tag: widths: '480, 750, 1000, 1300, 1600', sizes: '(min-width: 750px) 42rem, 100vw', loading: 'eager', fetchpriority: 'high'
        }}
      </div>
    {%- endif -%}

    <div class="rte article__content">{{ article.content }}</div>

    <footer class="article__footer">
      {%- if article.tags.size > 0 -%}
        <ul class="tag-list" role="list" aria-label="{{ 'blogs.article.tags' | t }}">
          {%- for tag in article.tags -%}
            <li><a class="chip-link" href="{{ blog.url }}/tagged/{{ tag | handle }}">{{ tag | escape }}</a></li>
          {%- endfor -%}
        </ul>
      {%- endif -%}

      {%- if blog.previous_article or blog.next_article -%}
        <nav class="article__pager" aria-label="{{ 'blogs.article.navigation' | t }}">
          {%- if blog.previous_article -%}
            <a class="link" href="{{ blog.previous_article.url }}">
              {%- render 'icon', name: 'arrow-left', class: 'icon--small' -%}
              {{ blog.previous_article.title | escape }}
            </a>
          {%- endif -%}
          {%- if blog.next_article -%}
            <a class="link" href="{{ blog.next_article.url }}">
              {{ blog.next_article.title | escape }}
              {%- render 'icon', name: 'arrow-right', class: 'icon--small' -%}
            </a>
          {%- endif -%}
        </nav>
      {%- endif -%}
    </footer>

    {%- if blog.comments_enabled? -%}
      <section class="comments" aria-labelledby="CommentsTitle">
        <h2 class="h3" id="CommentsTitle">{{ 'blogs.comments.title' | t: count: article.comments_count }}</h2>

        {%- paginate article.comments by 10 -%}
          {%- for comment in article.comments -%}
            <div class="comment">
              <div class="rte">{{ comment.content }}</div>
              <p class="comment__meta">{{ comment.author | escape }} · {{ comment.created_at | time_tag: format: 'date' }}</p>
            </div>
          {%- endfor -%}
          {% render 'pagination', paginate: paginate %}
        {%- endpaginate -%}

        {%- form 'new_comment', article, class: 'form-grid form-grid--2' -%}
          {%- if form.posted_successfully? -%}
            <p class="form-message form-message--success field--full" role="status" tabindex="-1" autofocus>
              {%- if blog.moderated? -%}{{ 'blogs.comments.success_moderated' | t }}{%- else -%}{{ 'blogs.comments.success' | t }}{%- endif -%}
            </p>
          {%- elsif form.errors -%}
            <p class="form-message form-message--error field--full" role="alert" tabindex="-1" autofocus>
              {{- form.errors | default_errors -}}
            </p>
          {%- endif -%}
          <h3 class="h4 field--full">{{ 'blogs.comments.form_title' | t }}</h3>
          <div class="field">
            <label class="field__label" for="CommentAuthor">{{ 'blogs.comments.name' | t }}</label>
            <input class="input" id="CommentAuthor" type="text" name="comment[author]" value="{{ form.author }}" autocomplete="name" required>
          </div>
          <div class="field">
            <label class="field__label" for="CommentEmail">{{ 'blogs.comments.email' | t }}</label>
            <input class="input" id="CommentEmail" type="email" name="comment[email]" value="{{ form.email }}" autocomplete="email" spellcheck="false" autocapitalize="off" required>
          </div>
          <div class="field field--full">
            <label class="field__label" for="CommentBody">{{ 'blogs.comments.message' | t }}</label>
            <textarea class="textarea" id="CommentBody" name="comment[body]" rows="5" required>{{ form.body }}</textarea>
          </div>
          {%- if blog.moderated? -%}
            <p class="text-small text-muted field--full">{{ 'blogs.comments.moderated' | t }}</p>
          {%- endif -%}
          <div class="field--full">
            <button type="submit" class="button">{{ 'blogs.comments.post' | t }}</button>
          </div>
        {%- endform -%}
      </section>
    {%- endif -%}
  </article>
</div>

<script type="application/ld+json">
  {{ article | structured_data }}
</script>

{% schema %}
{
  "name": "Articolo",
  "class": "section-main-article",
  "enabled_on": { "templates": ["article"] },
  "settings": [
    { "type": "checkbox", "id": "show_blog_link", "label": "Mostra link al blog", "default": true },
    { "type": "checkbox", "id": "show_image", "label": "Mostra immagine in evidenza", "default": true },
    { "type": "checkbox", "id": "show_date", "label": "Mostra data", "default": true },
    { "type": "checkbox", "id": "show_author", "label": "Mostra autore", "default": false },
    { "type": "header", "content": "Aspetto" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Schema colori", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "label": "Spazio sopra", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "padding_bottom", "label": "Spazio sotto", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 80 }
  ]
}
{% endschema %}
