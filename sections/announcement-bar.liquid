{%- liquid
  assign message_count = section.blocks.size
-%}
{%- if message_count > 0 -%}
  <div class="announcement color-{{ section.settings.color_scheme }}" role="region" aria-label="{{ 'sections.announcement.label' | t }}">
    <announcement-bar class="announcement__inner page-width">
      {%- if message_count > 1 -%}
        <button type="button" class="announcement__button" data-direction="-1" aria-label="{{ 'sections.announcement.previous' | t }}" aria-controls="AnnouncementTrack-{{ section.id }}">
          {%- render 'icon', name: 'chevron-left', class: 'icon--small' -%}
        </button>
      {%- endif -%}

      <div class="announcement__track" id="AnnouncementTrack-{{ section.id }}">
        {%- for block in section.blocks -%}
          <p class="announcement__item" {{ block.shopify_attributes }}>
            {%- if block.settings.link != blank -%}
              <a href="{{ block.settings.link }}">{{ block.settings.text | escape }}</a>
            {%- else -%}
              {{ block.settings.text | escape }}
            {%- endif -%}
          </p>
        {%- endfor -%}
      </div>

      {%- if message_count > 1 -%}
        <button type="button" class="announcement__button" data-direction="1" aria-label="{{ 'sections.announcement.next' | t }}" aria-controls="AnnouncementTrack-{{ section.id }}">
          {%- render 'icon', name: 'chevron-right', class: 'icon--small' -%}
        </button>
      {%- endif -%}
    </announcement-bar>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Barra annunci",
  "class": "section-announcement",
  "max_blocks": 6,
  "enabled_on": { "groups": ["header"] },
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Schema colori", "default": "scheme-5" },
    {
      "type": "paragraph",
      "content": "Con più messaggi compaiono le frecce per scorrerli: non c'è rotazione automatica."
    }
  ],
  "blocks": [
    {
      "type": "message",
      "name": "Messaggio",
      "settings": [
        { "type": "text", "id": "text", "label": "Testo", "default": "Spedizione gratuita sopra i 60 €" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Barra annunci",
      "blocks": [{ "type": "message" }]
    }
  ]
}
{% endschema %}
