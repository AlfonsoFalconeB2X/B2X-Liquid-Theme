{%- liquid
  assign s = section.settings
  assign columns = s.columns_desktop
  assign columns_tablet = columns | at_most: 2
-%}

<div {% render 'section-attributes', section: section %}>
  <div class="section__inner page-width">
    {%- render 'section-heading',
      kicker: s.kicker,
      heading: s.heading,
      text: s.text,
      align: s.heading_align
    -%}

    <ul
      class="grid grid--slider"
      role="list"
      style="--cols-mobile: 1; --cols-tablet: {{ columns_tablet }}; --cols-desktop: {{ columns }}; --slide-width: 85%;"
    >
      {%- for block in section.blocks -%}
        <li class="reveal" {{ block.shopify_attributes }}>
          <figure class="quote-card">
            <div>
              {%- if block.settings.rating > 0 -%}
                <p class="quote-card__rating">
                  <span class="visually-hidden">{{ 'sections.testimonials.rating' | t: rating: block.settings.rating }}</span>
                  {%- for i in (1..block.settings.rating) -%}
                    {% render 'icon', name: 'star', class: 'icon--small icon--fill' %}
                  {%- endfor -%}
                </p>
              {%- endif -%}
              <blockquote class="quote-card__text">{{ block.settings.quote }}</blockquote>
            </div>
            <figcaption class="quote-card__author">
              {%- if block.settings.avatar != blank -%}
                {{ block.settings.avatar | image_url: width: 120, height: 120, crop: 'center' | image_tag: class: 'quote-card__avatar', loading: 'lazy', alt: '' }}
              {%- endif -%}
              <span>
                <span class="quote-card__name">{{ block.settings.author | escape }}</span>
                {%- if block.settings.detail != blank -%}
                  <br><span class="text-muted">{{ block.settings.detail | escape }}</span>
                {%- endif -%}
              </span>
            </figcaption>
          </figure>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</div>

{% schema %}
{
  "name": "Recensioni",
  "class": "section-testimonials",
  "max_blocks": 9,
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "text", "id": "kicker", "label": "Etichetta" },
    { "type": "text", "id": "heading", "label": "Titolo", "default": "Dicono di noi" },
    { "type": "richtext", "id": "text", "label": "Testo" },
    {
      "type": "select",
      "id": "heading_align",
      "label": "Allineamento intestazione",
      "options": [
        { "value": "left", "label": "Sinistra" },
        { "value": "center", "label": "Centro" }
      ],
      "default": "left"
    },
    { "type": "range", "id": "columns_desktop", "label": "Colonne su desktop", "min": 2, "max": 4, "step": 1, "default": 3 },
    { "type": "header", "content": "Aspetto" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Schema colori", "default": "scheme-4" },
    {
      "type": "select",
      "id": "section_style",
      "label": "Stile",
      "options": [
        { "value": "full", "label": "A tutta larghezza" },
        { "value": "boxed", "label": "Riquadro" }
      ],
      "default": "boxed"
    },
    { "type": "range", "id": "padding_top", "label": "Spazio sopra", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 64 },
    { "type": "range", "id": "padding_bottom", "label": "Spazio sotto", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 64 }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Recensione",
      "settings": [
        { "type": "range", "id": "rating", "label": "Stelle", "min": 0, "max": 5, "step": 1, "default": 5 },
        {
          "type": "richtext",
          "id": "quote",
          "label": "Testo",
          "default": "<p>Prodotto arrivato in due giorni, curato in ogni dettaglio. Tornerò sicuramente.</p>"
        },
        { "type": "text", "id": "author", "label": "Autore", "default": "Giulia R." },
        { "type": "text", "id": "detail", "label": "Dettaglio", "default": "Cliente verificata" },
        { "type": "image_picker", "id": "avatar", "label": "Foto" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Recensioni",
      "blocks": [
        { "type": "testimonial" },
        { "type": "testimonial", "settings": { "author": "Marco B.", "quote": "<p>Ottimo rapporto qualità prezzo e un'assistenza davvero gentile.</p>" } },
        { "type": "testimonial", "settings": { "author": "Sara L.", "quote": "<p>Il regalo perfetto: confezione bellissima e consegna puntuale.</p>" } }
      ]
    }
  ]
}
{% endschema %}
