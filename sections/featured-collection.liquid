{%- liquid
  assign s = section.settings
  assign collection = s.collection
  assign columns = s.columns_desktop
  assign columns_tablet = columns | at_most: 3
  assign column_width = settings.page_width | divided_by: columns
  assign sizes = '(min-width: 990px) ' | append: column_width | append: 'px, (min-width: 750px) 33vw, '
  if s.columns_mobile == '2'
    assign sizes = sizes | append: '50vw'
    assign slide_width = '44%'
  else
    assign sizes = sizes | append: '85vw'
    assign slide_width = '80%'
  endif

  assign link_url = s.link_url
  if link_url == blank and collection != blank
    assign link_url = collection.url
  endif

  assign carousel = false
  if s.layout == 'carousel'
    assign carousel = true
    assign per_view_mobile = '1.15'
    if s.columns_mobile == '2'
      assign per_view_mobile = '2.2'
    endif
  endif
-%}

{%- if carousel -%}
  {% render 'vite-tag', entry: 'carousel.css' %}
  {% render 'vite-tag', entry: 'carousel.js' %}
{%- endif -%}

{%- capture heading -%}
  {%- render 'section-heading',
    kicker: s.kicker,
    heading: s.heading,
    text: s.text,
    link_label: s.link_label,
    link_url: link_url,
    align: s.heading_align
  -%}
{%- endcapture -%}

{%- capture items -%}
  {%- if collection != blank and collection.products_count > 0 -%}
    {%- for product in collection.products limit: s.products_to_show -%}
      <li class="reveal{% if carousel %} carousel__slide{% endif %}">
        {% render 'product-card', product: product, section_id: section.id, sizes: sizes %}
      </li>
    {%- endfor -%}
  {%- else -%}
    {%- for i in (1..s.products_to_show) -%}
      <li class="reveal{% if carousel %} carousel__slide{% endif %}">
        {% render 'product-card', product: blank, placeholder_index: forloop.index0, section_id: section.id %}
      </li>
    {%- endfor -%}
  {%- endif -%}
{%- endcapture -%}

<div {% render 'section-attributes', section: section %}>
  <div class="section__inner page-width">
    {%- if carousel -%}
      {%- render 'carousel-track',
        id: section.id,
        items: items,
        heading: heading,
        align: s.heading_align,
        label: s.heading,
        per_view: columns,
        per_view_mobile: per_view_mobile
      -%}
    {%- else -%}
      {{- heading -}}
      <ul
        class="grid{% if s.slider_mobile %} grid--slider{% endif %}"
        role="list"
        style="--cols-mobile: {{ s.columns_mobile }}; --cols-tablet: {{ columns_tablet }}; --cols-desktop: {{ columns }}; --slide-width: {{ slide_width }};"
      >
        {{- items -}}
      </ul>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Collezione in evidenza",
  "class": "section-featured-collection",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "text", "id": "kicker", "label": "Etichetta" },
    { "type": "text", "id": "heading", "label": "Titolo", "default": "I più amati" },
    { "type": "richtext", "id": "text", "label": "Testo" },
    {
      "type": "select",
      "id": "heading_align",
      "label": "Allineamento intestazione",
      "options": [
        { "value": "left", "label": "Sinistra" },
        { "value": "center", "label": "Centro" }
      ],
      "default": "left"
    },
    { "type": "collection", "id": "collection", "label": "Collezione" },
    { "type": "range", "id": "products_to_show", "label": "Prodotti da mostrare", "min": 2, "max": 16, "step": 1, "default": 8 },
    { "type": "text", "id": "link_label", "label": "Etichetta link", "default": "Vedi tutti" },
    {
      "type": "url",
      "id": "link_url",
      "label": "Link",
      "info": "Se vuoto porta alla collezione scelta."
    },
    { "type": "header", "content": "Disposizione" },
    {
      "type": "select",
      "id": "layout",
      "label": "Mostra come",
      "options": [
        { "value": "grid", "label": "Griglia" },
        { "value": "carousel", "label": "Carosello" }
      ],
      "default": "grid"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Colonne su desktop",
      "info": "Con il carosello: prodotti visibili insieme.",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Colonne su mobile",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" }
      ],
      "default": "2"
    },
    {
      "type": "checkbox",
      "id": "slider_mobile",
      "label": "Scorrimento orizzontale su mobile",
      "default": true,
      "visible_if": "{{ section.settings.layout == 'grid' }}"
    },
    { "type": "header", "content": "Aspetto" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Schema colori", "default": "scheme-1" },
    {
      "type": "select",
      "id": "section_style",
      "label": "Stile",
      "options": [
        { "value": "full", "label": "A tutta larghezza" },
        { "value": "boxed", "label": "Riquadro" }
      ],
      "default": "full"
    },
    { "type": "range", "id": "padding_top", "label": "Spazio sopra", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 64 },
    { "type": "range", "id": "padding_bottom", "label": "Spazio sotto", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 64 }
  ],
  "presets": [{ "name": "Collezione in evidenza" }]
}
{% endschema %}
