{%- liquid
  assign s = section.settings
  assign is_overlay = false
  if s.layout == 'overlay'
    assign is_overlay = true
  endif

  assign loading = 'lazy'
  assign priority = 'auto'
  if section.index == 1
    assign loading = 'eager'
    assign priority = 'high'
  endif

  case s.height
    when 'small'
      assign hero_height = 'max(22rem, 50svh)'
    when 'large'
      assign hero_height = 'max(32rem, 82svh)'
    when 'full'
      assign hero_height = 'calc(100svh - var(--header-offset))'
    else
      assign hero_height = 'max(26rem, 66svh)'
  endcase

  case s.vertical_align
    when 'top'
      assign hero_align = 'start'
    when 'bottom'
      assign hero_align = 'end'
    else
      assign hero_align = 'center'
  endcase

  case s.image_ratio
    when 'square'
      assign ratio = 1
    when 'landscape'
      assign ratio = 1.333
    else
      assign ratio = 0.8
  endcase

  assign overlay = s.overlay_opacity | divided_by: 100.0
  assign style_vars = '--hero-height: ' | append: hero_height | append: '; --hero-align: ' | append: hero_align | append: '; --overlay: ' | append: overlay | append: ';'
  assign section_class = 'section--hero'
  if is_overlay
    assign section_class = 'section--hero section--hero-overlay'
  endif

  assign half_page = settings.page_width | divided_by: 2
  assign split_sizes = '(min-width: 990px) ' | append: half_page | append: 'px, 100vw'

  assign heading_class = 'h1'
  if s.heading_size == 'xl'
    assign heading_class = 'h0'
  endif
-%}

{%- capture content -%}
  <div class="hero__content{% if s.content_align == 'center' %} hero__content--center{% endif %}{% if is_overlay %} on-media{% endif %}">
    {%- if s.kicker != blank -%}
      <p class="kicker">{{ s.kicker | escape }}</p>
    {%- endif -%}
    {%- if s.heading != blank -%}
      <h2 class="{{ heading_class }}">{{ s.heading | escape }}</h2>
    {%- endif -%}
    {%- if s.text != blank -%}
      <div class="rte text-lead hero__text{% unless is_overlay %} text-muted{% endunless %}">{{ s.text }}</div>
    {%- endif -%}
    {%- liquid
      assign has_button = false
      assign has_button_2 = false
      if s.button_label != blank and s.button_link != blank
        assign has_button = true
      endif
      if s.button_label_2 != blank and s.button_link_2 != blank
        assign has_button_2 = true
      endif
    -%}
    {%- if has_button or has_button_2 -%}
      <div class="button-group">
        {%- if has_button -%}
          <a class="button button--large" href="{{ s.button_link }}">{{ s.button_label | escape }}</a>
        {%- endif -%}
        {%- if has_button_2 -%}
          <a class="button button--large button--secondary" href="{{ s.button_link_2 }}">{{ s.button_label_2 | escape }}</a>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
{%- endcapture -%}

{%- capture picture -%}
  {%- if s.image != blank -%}
    <picture>
      {%- if s.image_mobile != blank -%}
        <source
          media="(max-width: 749px)"
          srcset="{{ s.image_mobile | image_url: width: 750 }} 750w, {{ s.image_mobile | image_url: width: 1100 }} 1100w, {{ s.image_mobile | image_url: width: 1500 }} 1500w"
          sizes="100vw"
        >
      {%- endif -%}
      {%- if is_overlay -%}
        {{
          s.image
          | image_url: width: 3000
          | image_tag:
            widths: '750, 1100, 1500, 1800, 2200, 2600, 3000',
            sizes: '100vw',
            loading: loading,
            fetchpriority: priority
        }}
      {%- else -%}
        {{
          s.image
          | image_url: width: 2000
          | image_tag:
            widths: '480, 750, 1000, 1300, 1600, 2000',
            sizes: split_sizes,
            loading: loading,
            fetchpriority: priority
        }}
      {%- endif -%}
    </picture>
  {%- else -%}
    {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
  {%- endif -%}
{%- endcapture -%}

<div {% render 'section-attributes', section: section, class: section_class, style_vars: style_vars %}>
  <div class="section__inner page-width">
    {%- if is_overlay -%}
      <div class="hero__backdrop">{{ picture }}</div>
      <div class="hero">{{ content }}</div>
    {%- else -%}
      <div class="hero hero--split{% if s.media_position == 'start' %} hero--media-first{% endif %}">
        {{ content }}
        <div class="hero__media">
          <div class="media" style="--ratio: {{ ratio }};">{{ picture }}</div>
        </div>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Hero",
  "class": "section-hero",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    {
      "type": "select",
      "id": "layout",
      "label": "Disposizione",
      "options": [
        { "value": "split", "label": "Testo e immagine affiancati" },
        { "value": "overlay", "label": "Testo sopra l'immagine" }
      ],
      "default": "split"
    },
    { "type": "image_picker", "id": "image", "label": "Immagine" },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Immagine per mobile",
      "info": "Facoltativa: sostituisce l'immagine sotto i 750px."
    },
    { "type": "header", "content": "Contenuto" },
    { "type": "text", "id": "kicker", "label": "Etichetta", "default": "Nuova collezione" },
    { "type": "text", "id": "heading", "label": "Titolo", "default": "Pezzi essenziali, scelti con cura" },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Dimensione titolo",
      "options": [
        { "value": "large", "label": "Grande" },
        { "value": "xl", "label": "Molto grande" }
      ],
      "default": "large"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Testo",
      "default": "<p>Materiali buoni, forme semplici e spedizione veloce in tutta Italia.</p>"
    },
    { "type": "text", "id": "button_label", "label": "Etichetta pulsante principale", "default": "Scopri i prodotti" },
    { "type": "url", "id": "button_link", "label": "Link pulsante principale", "default": "/collections/all" },
    { "type": "text", "id": "button_label_2", "label": "Etichetta pulsante secondario" },
    { "type": "url", "id": "button_link_2", "label": "Link pulsante secondario" },
    {
      "type": "select",
      "id": "content_align",
      "label": "Allineamento del testo",
      "options": [
        { "value": "left", "label": "Sinistra" },
        { "value": "center", "label": "Centro" }
      ],
      "default": "left"
    },
    { "type": "header", "content": "Testo e immagine affiancati" },
    {
      "type": "select",
      "id": "media_position",
      "label": "Posizione immagine (desktop)",
      "options": [
        { "value": "end", "label": "Destra" },
        { "value": "start", "label": "Sinistra" }
      ],
      "default": "end"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Proporzioni immagine",
      "options": [
        { "value": "portrait", "label": "Verticale" },
        { "value": "square", "label": "Quadrata" },
        { "value": "landscape", "label": "Orizzontale" }
      ],
      "default": "portrait"
    },
    { "type": "header", "content": "Testo sopra l'immagine" },
    {
      "type": "select",
      "id": "height",
      "label": "Altezza",
      "options": [
        { "value": "small", "label": "Bassa" },
        { "value": "medium", "label": "Media" },
        { "value": "large", "label": "Alta" },
        { "value": "full", "label": "Tutto lo schermo" }
      ],
      "default": "medium"
    },
    {
      "type": "select",
      "id": "vertical_align",
      "label": "Posizione verticale del testo",
      "options": [
        { "value": "top", "label": "In alto" },
        { "value": "center", "label": "Al centro" },
        { "value": "bottom", "label": "In basso" }
      ],
      "default": "bottom"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Velo scuro sull'immagine",
      "info": "Garantisce la leggibilità del testo bianco.",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "default": 35
    },
    { "type": "header", "content": "Aspetto" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Schema colori", "default": "scheme-2" },
    {
      "type": "select",
      "id": "section_style",
      "label": "Stile",
      "options": [
        { "value": "full", "label": "A tutta larghezza" },
        { "value": "boxed", "label": "Riquadro" }
      ],
      "default": "boxed"
    },
    { "type": "range", "id": "padding_top", "label": "Spazio sopra", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 64 },
    { "type": "range", "id": "padding_bottom", "label": "Spazio sotto", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 64 }
  ],
  "presets": [{ "name": "Hero" }]
}
{% endschema %}
