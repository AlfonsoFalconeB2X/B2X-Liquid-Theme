{%- liquid
  assign s = section.settings
  assign columns = s.columns_desktop
  assign columns_tablet = columns | at_most: 2
  assign column_width = settings.page_width | divided_by: columns
  assign sizes = '(min-width: 990px) ' | append: column_width | append: 'px, (min-width: 750px) 50vw, 100vw'
-%}

<div {% render 'section-attributes', section: section %}>
  <div class="section__inner page-width">
    {%- render 'section-heading',
      kicker: s.kicker,
      heading: s.heading,
      text: s.text,
      align: s.heading_align
    -%}

    <ul
      class="grid{% if s.slider_mobile %} grid--slider{% endif %}"
      role="list"
      style="--cols-mobile: 1; --cols-tablet: {{ columns_tablet }}; --cols-desktop: {{ columns }}; --slide-width: 80%;"
    >
      {%- for block in section.blocks -%}
        <li class="feature{% if s.card_style == 'surface' %} feature--surface{% endif %}{% if s.align == 'center' %} feature--center{% endif %} reveal" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            <div class="media" style="--ratio: {{ s.image_ratio }};">
              {{ block.settings.image | image_url: width: 1200 | image_tag: widths: '320, 480, 640, 900, 1200', sizes: sizes, loading: 'lazy' }}
            </div>
          {%- elsif block.settings.icon != 'none' -%}
            <span class="feature__icon">{% render 'icon', name: block.settings.icon %}</span>
          {%- endif -%}

          {%- if block.settings.title != blank -%}
            <h3 class="feature__title">{{ block.settings.title | escape }}</h3>
          {%- endif -%}
          {%- if block.settings.text != blank -%}
            <div class="rte feature__text">{{ block.settings.text }}</div>
          {%- endif -%}
          {%- if block.settings.link_label != blank and block.settings.link != blank -%}
            <a class="link" href="{{ block.settings.link }}">
              {{- block.settings.link_label | escape -}}
              {%- render 'icon', name: 'arrow-right', class: 'icon--small' -%}
            </a>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  </div>
</div>

{% schema %}
{
  "name": "Colonne",
  "class": "section-multicolumn",
  "max_blocks": 8,
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "text", "id": "kicker", "label": "Etichetta" },
    { "type": "text", "id": "heading", "label": "Titolo", "default": "Perché sceglierci" },
    { "type": "richtext", "id": "text", "label": "Testo" },
    {
      "type": "select",
      "id": "heading_align",
      "label": "Allineamento intestazione",
      "options": [
        { "value": "left", "label": "Sinistra" },
        { "value": "center", "label": "Centro" }
      ],
      "default": "left"
    },
    { "type": "header", "content": "Colonne" },
    { "type": "range", "id": "columns_desktop", "label": "Colonne su desktop", "min": 2, "max": 4, "step": 1, "default": 3 },
    {
      "type": "select",
      "id": "card_style",
      "label": "Stile colonne",
      "options": [
        { "value": "plain", "label": "Semplice" },
        { "value": "surface", "label": "Su superficie" }
      ],
      "default": "surface"
    },
    {
      "type": "select",
      "id": "align",
      "label": "Allineamento colonne",
      "options": [
        { "value": "left", "label": "Sinistra" },
        { "value": "center", "label": "Centro" }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Proporzioni immagini",
      "options": [
        { "value": "1.5", "label": "Orizzontali" },
        { "value": "1", "label": "Quadrate" },
        { "value": "0.8", "label": "Verticali" }
      ],
      "default": "1.5"
    },
    { "type": "checkbox", "id": "slider_mobile", "label": "Scorrimento orizzontale su mobile", "default": false },
    { "type": "header", "content": "Aspetto" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Schema colori", "default": "scheme-1" },
    {
      "type": "select",
      "id": "section_style",
      "label": "Stile",
      "options": [
        { "value": "full", "label": "A tutta larghezza" },
        { "value": "boxed", "label": "Riquadro" }
      ],
      "default": "full"
    },
    { "type": "range", "id": "padding_top", "label": "Spazio sopra", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 64 },
    { "type": "range", "id": "padding_bottom", "label": "Spazio sotto", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 64 }
  ],
  "blocks": [
    {
      "type": "column",
      "name": "Colonna",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icona",
          "info": "Non viene mostrata se scegli un'immagine.",
          "options": [
            { "value": "none", "label": "Nessuna" },
            { "value": "truck", "label": "Spedizione" },
            { "value": "return", "label": "Reso" },
            { "value": "lock", "label": "Pagamento sicuro" },
            { "value": "chat", "label": "Assistenza" },
            { "value": "leaf", "label": "Natura" },
            { "value": "gift", "label": "Regalo" },
            { "value": "star", "label": "Qualità" },
            { "value": "heart", "label": "Cuore" },
            { "value": "pin", "label": "Luogo" }
          ],
          "default": "truck"
        },
        { "type": "image_picker", "id": "image", "label": "Immagine" },
        { "type": "text", "id": "title", "label": "Titolo", "default": "Spedizione veloce" },
        {
          "type": "richtext",
          "id": "text",
          "label": "Testo",
          "default": "<p>Consegna in 24/48 ore in tutta Italia.</p>"
        },
        { "type": "text", "id": "link_label", "label": "Etichetta link" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Colonne",
      "blocks": [
        { "type": "column", "settings": { "icon": "truck", "title": "Spedizione veloce" } },
        { "type": "column", "settings": { "icon": "return", "title": "Reso facile", "text": "<p>Hai 30 giorni per cambiare idea.</p>" } },
        { "type": "column", "settings": { "icon": "chat", "title": "Assistenza vera", "text": "<p>Rispondiamo a ogni messaggio entro un giorno lavorativo.</p>" } }
      ]
    }
  ]
}
{% endschema %}
