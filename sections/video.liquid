{%- liquid
  assign s = section.settings
  assign has_video = false
  if s.video != blank or s.video_url != blank
    assign has_video = true
  endif
  assign video_title = s.description | default: s.heading | default: shop.name | escape
  assign poster = s.poster
  if poster == blank and s.video != blank
    assign poster = s.video.preview_image
  endif
-%}

<div {% render 'section-attributes', section: section %}>
  <div class="section__inner page-width{% if s.width == 'narrow' %} page-width--narrow{% endif %}">
    {%- render 'section-heading', kicker: s.kicker, heading: s.heading, text: s.text, align: 'center' -%}

    <deferred-media class="media video-embed reveal">
      {%- if poster != blank -%}
        {{ poster | image_url: width: 2000 | image_tag: widths: '750, 1100, 1500, 2000', sizes: '100vw', loading: 'lazy', alt: '' }}
      {%- else -%}
        {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
      {%- endif -%}

      {%- if has_video -%}
        <button type="button" class="video-embed__poster" data-deferred-play>
          <span class="video-embed__play">{% render 'icon', name: 'play', class: 'icon--fill' %}</span>
          <span class="visually-hidden">{{ 'sections.video.play' | t: title: video_title }}</span>
        </button>
        <template>
          {%- if s.video != blank -%}
            {{ s.video | video_tag: controls: true, playsinline: true, preload: 'metadata', autoplay: true }}
          {%- else -%}
            {%- if s.video_url.type == 'youtube' -%}
              <iframe
                src="https://www.youtube-nocookie.com/embed/{{ s.video_url.id }}?autoplay=1&rel=0"
                title="{{ video_title }}"
                allow="autoplay; encrypted-media; picture-in-picture; fullscreen"
                allowfullscreen
              ></iframe>
            {%- else -%}
              <iframe
                src="https://player.vimeo.com/video/{{ s.video_url.id }}?autoplay=1&dnt=1"
                title="{{ video_title }}"
                allow="autoplay; fullscreen; picture-in-picture"
                allowfullscreen
              ></iframe>
            {%- endif -%}
          {%- endif -%}
        </template>
      {%- endif -%}
    </deferred-media>
  </div>
</div>

{% schema %}
{
  "name": "Video",
  "class": "section-video",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "text", "id": "kicker", "label": "Etichetta" },
    { "type": "text", "id": "heading", "label": "Titolo" },
    { "type": "richtext", "id": "text", "label": "Testo" },
    { "type": "video", "id": "video", "label": "Video caricato su Shopify" },
    {
      "type": "video_url",
      "id": "video_url",
      "label": "Oppure link YouTube o Vimeo",
      "accept": ["youtube", "vimeo"]
    },
    { "type": "image_picker", "id": "poster", "label": "Immagine di anteprima" },
    {
      "type": "text",
      "id": "description",
      "label": "Descrizione del video",
      "info": "Letta dai lettori di schermo sul pulsante di riproduzione."
    },
    {
      "type": "select",
      "id": "width",
      "label": "Larghezza",
      "options": [
        { "value": "page", "label": "Pagina" },
        { "value": "narrow", "label": "Stretta" }
      ],
      "default": "page"
    },
    { "type": "header", "content": "Aspetto" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Schema colori", "default": "scheme-1" },
    {
      "type": "select",
      "id": "section_style",
      "label": "Stile",
      "options": [
        { "value": "full", "label": "A tutta larghezza" },
        { "value": "boxed", "label": "Riquadro" }
      ],
      "default": "full"
    },
    { "type": "range", "id": "padding_top", "label": "Spazio sopra", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 64 },
    { "type": "range", "id": "padding_bottom", "label": "Spazio sotto", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 64 }
  ],
  "presets": [{ "name": "Video" }]
}
{% endschema %}
